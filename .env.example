APP_ENV=local
APP_URL=http://localhost:4173

# Banco de testes na VPS Hostinger
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cnm_risco_test
DB_USERNAME=cnm_risco_app
DB_PASSWORD=defina-fora-do-repositorio

# Armazenamento dos pacotes de comprovação
UPLOAD_DISK=local
UPLOAD_PATH=storage/uploads
MAX_UPLOAD_MB=512

# gov.br — preencher somente no servidor, nunca versionar
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI=
